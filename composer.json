{
    "name": "brumisphere/hardening",
    "description": "Durcissement WordPress partagé Brumisphère. Actif quel que soit le thème, indépendant du socle de thème.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^3.10",
        "wp-coding-standards/wpcs": "^3.1",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "phpstan/phpstan": "^1.11",
        "szepeviktor/phpstan-wordpress": "^1.3"
    },
    "autoload": {
        "psr-4": {
            "Brumisphere\\Hardening\\": "src/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "scripts": {
        "lint": "phpcs --standard=phpcs.xml src/",
        "lint:fix": "phpcbf --standard=phpcs.xml src/",
        "analyse": "phpstan analyse src/ --level=6",
        "test": "php tests/executer.php"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.x-dev"
        }
    }
}
